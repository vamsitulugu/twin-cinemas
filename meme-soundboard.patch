+  c.onclick=()=>play(id,false);grid.appendChild(c);cards.set(id,c)}
+ grid.appendChild(empty);
+ const clearOn=()=>cards.forEach(c=>c.classList.remove('on'));
+ function stop(){audio.memeStop();clearOn();cur=null}
